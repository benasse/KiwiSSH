# KiwiSSH Docker Compose configuration
#
# Prepare the Docker Compose configuration before starting the stack:
#   cp docker-compose.yaml.example docker-compose.yaml
#   cp docker.env.example docker.env
#
# Start Docker Compose with:
#   docker compose --env-file docker.env -f docker-compose.yaml up -d
#
# Do not commit docker.env: it contains deployment-specific paths and credentials.

# Timezone used by all containers (IANA timezone name).
TZ=Europe/Berlin

# KiwiSSH must connect to real devices in Docker deployments.
KIWISSH_LOCAL_TEST_MODE=false

# Container image tags.
KIWISSH_BACKEND_IMAGE_TAG=latest
KIWISSH_FRONTEND_IMAGE_TAG=latest
POSTGRES_IMAGE_TAG=18

# PostgreSQL application database.
# Change the password before exposing this stack outside a trusted local environment.
POSTGRES_DB=kiwissh
POSTGRES_USER=kiwissh_user
POSTGRES_PASSWORD=change-me

# Persistent PostgreSQL data directory on the Docker host.
# PostgreSQL 18+ stores version-specific data below this directory.
POSTGRES_DATA_DIR=./local/postgres

# SSH trace output directory on the Docker host.
KIWISSH_SSH_TRACE_DIR=./local/backend/debug

# Required KiwiSSH configuration file.
KIWISSH_CONFIG_FILE=./local/backend/config/kiwissh.yaml

# Required persistent backup directory.
# CRITICAL: backups are lost on container recreation if this directory is not mounted persistently.
KIWISSH_BACKUPS_DIR=./local/backend/config/kiwissh_backups/

# Optional device source directory. Mount the directory so reloads detect atomically replaced files.
KIWISSH_SOURCES_DIR=./local/backend/config/sources

# Optional custom vendor definitions directory.
KIWISSH_VENDORS_DIR=./local/backend/config/vendors

# Optional SSH profiles file.
KIWISSH_SSH_PROFILES_FILE=./local/backend/config/ssh_profiles.yaml

# Optional SSH keys and configuration directory. Ensure its contents use uid:gid 1000:1000.
KIWISSH_SSH_MATERIAL_DIR=./local/backend/config/ssh_material
